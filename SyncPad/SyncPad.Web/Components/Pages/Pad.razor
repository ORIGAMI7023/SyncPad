@code {
    private string _content = string.Empty;
    private string _connectionStatus = "未连接";
    private bool _isConnected = false;
    private bool _isUpdatingFromServer = false;
    private bool _isInitialized = false;
    private CancellationTokenSource? _throttleCts;
    private readonly object _throttleLock = new();
    private ElementReference _textareaRef;

    // 文件列表
    private List<SelectableFileItemWeb> _files = new();
    private int SelectedFilesCount => _files.Count(f => f.IsSelected);
    private int _lastSelectedIndex = -1;

    // 拖放状态
    private ElementReference _fileGridRef;
    private DotNetObjectReference<Pad>? _dotNetRef;

    // 操作菜单状态
    private bool _menuVisible = false;
    private int _menuX = 0;
    private int _menuY = 0;
    private SelectableFileItemWeb? _menuFile = null;
    private DotNetObjectReference<Pad>? _contextMenuDotNetRef;

    protected override void OnInitialized()
    {
        // 订阅事件（只订阅一次）
        TextHubClient.ConnectionStateChanged += OnConnectionStateChanged;
        TextHubClient.TextUpdateReceived += OnTextUpdateReceived;
        TextHubClient.FileUpdateReceived += OnFileUpdateReceived;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

            // 先尝试恢复会���（需要 JS 互操作）
            await AuthManager.TryRestoreSessionAsync();

            // 检查是否已登录
            if (!AuthManager.IsLoggedIn)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // 初始化拖放区域的 JS 互操作
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("DragDropInterop.initDropZone", _fileGridRef, _dotNetRef);

            // 初始化右键菜单的 JS 互操作
            _contextMenuDotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("DragDropInterop.initContextMenu", _fileGridRef, _contextMenuDotNetRef);

            // 初始化键盘快捷键的 JS 互操作
            await JSRuntime.InvokeVoidAsync("DragDropInterop.initKeyboardShortcuts", _contextMenuDotNetRef);

            // 连接 SignalR
            await ConnectToHub();

            // 加载初始文本
            await RefreshText();

            // 加载文件列表
            await RefreshFiles();
        }
    }

    private async Task ConnectToHub()
    {
        try
        {
            _connectionStatus = "连接中...";
            StateHasChanged();

            var hubUrl = AuthManager.GetHubUrl();
            var token = AuthManager.Token;

            if (!string.IsNullOrEmpty(token))
            {
                await TextHubClient.ConnectAsync(hubUrl, token);
            }
        }
        catch (Exception ex)
        {
            _connectionStatus = $"连接失败: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task RefreshText()
    {
        try
        {
            var response = await ApiClient.GetTextAsync();
            if (response.Success && response.Data != null)
            {
                _isUpdatingFromServer = true;
                _content = response.Data.Content;
                _isUpdatingFromServer = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"刷新文本失败: {ex.Message}");
        }
    }

    private async Task RefreshFiles()
    {
        try
        {
            var response = await FileClient.GetFilesAsync();
            if (response.Success && response.Data != null)
            {
                _files = response.Data.Files.Select(f => new SelectableFileItemWeb(f)).ToList();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"刷新文件列表失败: {ex.Message}");
        }
    }

    private void HandleTextChange()
    {
        if (!_isUpdatingFromServer)
        {
            ThrottleSendUpdate();
        }
    }

    // 处理输入事件（包括粘贴后的手动输入）
    private void HandleTextInput()
    {
        if (!_isUpdatingFromServer)
        {
            ThrottleSendUpdate();
        }
    }

    // 处理粘贴事件（修复移动端长按粘贴不触发同步的问题）
    private void HandleTextPaste()
    {
        if (!_isUpdatingFromServer)
        {
            // 延迟一小段时间让浏览器完成粘贴操作，然后从 DOM 读取最新值并同步
            Task.Delay(100).ContinueWith(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    try
                    {
                        // 从 DOM 中读取最新的文本内容
                        var latestContent = await JSRuntime.InvokeAsync<string>("eval",
                            "document.getElementById('syncpad-textarea')?.value || ''");

                        // 更新绑定字段
                        _content = latestContent;

                        // 触发同步
                        ThrottleSendUpdate();
                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"粘贴同步失败: {ex.Message}");
                    }
                });
            });
        }
    }

    // 移动端工具栏按钮：全选
    private async Task SelectAllText()
    {
        try
        {
            // iOS 需要 setTimeout 延迟，等待键盘弹起或焦点稳定
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    var textarea = document.getElementById('syncpad-textarea');
                    if (textarea) {
                        textarea.focus();
                        setTimeout(function() {
                            textarea.setSelectionRange(0, 99999);
                            if (typeof textarea.select === 'function') {
                                textarea.select();
                            }
                        }, 100);
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"全选失败: {ex.Message}");
        }
    }

    // 移动端工具栏按钮：复制
    private async Task CopyText()
    {
        try
        {
            // 先尝试使用 Clipboard API，失败则降级到 execCommand
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    var textarea = document.getElementById('syncpad-textarea');
                    if (textarea && navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(textarea.value).catch(function(err) {
                            textarea.select();
                            document.execCommand('copy');
                        });
                    } else {
                        textarea.select();
                        document.execCommand('copy');
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"复制失败: {ex.Message}");
        }
    }

    // 移动端工具栏按钮：清空
    private void ClearText()
    {
        _content = string.Empty;
        ThrottleSendUpdate();
        StateHasChanged();
    }

    private void ThrottleSendUpdate()
    {
        lock (_throttleLock)
        {
            _throttleCts?.Cancel();
            _throttleCts = new CancellationTokenSource();
            var token = _throttleCts.Token;
            var currentContent = _content;

            Task.Delay(300, token).ContinueWith(async _ =>
            {
                if (!token.IsCancellationRequested && TextHubClient.IsConnected)
                {
                    await TextHubClient.SendTextUpdateAsync(currentContent);
                }
            }, TaskContinuationOptions.OnlyOnRanToCompletion);
        }
    }

    private void OnConnectionStateChanged(bool connected)
    {
        InvokeAsync(() =>
        {
            _isConnected = connected;
            _connectionStatus = connected ? "已连接" : "已断开";
            StateHasChanged();
        });
    }

    private void OnTextUpdateReceived(TextSyncMessage message)
    {
        InvokeAsync(() =>
        {
            _isUpdatingFromServer = true;
            _content = message.Content;
            _isUpdatingFromServer = false;
            StateHasChanged();
        });
    }

    private void OnFileUpdateReceived(FileSyncMessage message)
    {
        InvokeAsync(() =>
        {
            switch (message.Action)
            {
                case "added":
                    if (message.File != null)
                    {
                        var existing = _files.FirstOrDefault(f => f.File.FileName == message.File.FileName);
                        if (existing != null)
                            _files.Remove(existing);

                        _files.Insert(0, new SelectableFileItemWeb(message.File));
                    }
                    break;

                case "deleted":
                    if (message.FileId.HasValue)
                    {
                        var toRemove = _files.FirstOrDefault(f => f.File.Id == message.FileId.Value);
                        if (toRemove != null)
                            _files.Remove(toRemove);
                    }
                    break;
            }

            StateHasChanged();
        });
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            await UploadFile(file);
        }
    }

    private async Task UploadFile(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        try
        {
            // 检查同名文件
            if (await FileClient.FileExistsAsync(file.Name))
            {
                // Web 环境下使用 JS Interop 来显示确认对话框
                // 这里简化处理，直接覆盖
                using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                await FileClient.UploadFileAsync(file.Name, stream, file.ContentType, overwrite: true);
            }
            else
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                var response = await FileClient.UploadFileAsync(file.Name, stream, file.ContentType);

                if (!response.Success)
                {
                    Console.WriteLine($"上传失败: {response.ErrorMessage}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"上传文件失败: {ex.Message}");
        }
    }

    private void HandleFileClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, SelectableFileItemWeb file)
    {
        var currentIndex = _files.IndexOf(file);

        if (e.CtrlKey)
        {
            // Ctrl + 单击：切换选中状态
            file.IsSelected = !file.IsSelected;
            _lastSelectedIndex = file.IsSelected ? currentIndex : -1;
        }
        else if (e.ShiftKey && _lastSelectedIndex >= 0)
        {
            // Shift + 单击：范围选择
            var startIndex = Math.Min(_lastSelectedIndex, currentIndex);
            var endIndex = Math.Max(_lastSelectedIndex, currentIndex);

            for (int i = startIndex; i <= endIndex; i++)
            {
                _files[i].IsSelected = true;
            }
        }
        else
        {
            // 普通单击：清除其他选择，仅选中当前
            foreach (var f in _files)
            {
                f.IsSelected = false;
            }
            file.IsSelected = true;
            _lastSelectedIndex = currentIndex;
        }

        StateHasChanged();
    }

    private void DownloadFile(SelectableFileItemWeb file)
    {
        var url = FileClient.GetDownloadUrl(file.File.Id);
        Navigation.NavigateTo(url, true);
    }

    private async Task DeleteFile(SelectableFileItemWeb file)
    {
        // 简化处理，直接删除
        try
        {
            var response = await FileClient.DeleteFileAsync(file.File.Id);
            if (!response.Success)
            {
                Console.WriteLine($"删除失败: {response.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"删除文件失败: {ex.Message}");
        }
    }

    private void OnFileSelectionChanged()
    {
        StateHasChanged();
    }

    private void ToggleSelection(SelectableFileItemWeb file)
    {
        file.IsSelected = !file.IsSelected;
        StateHasChanged();
    }

    private void ClearSelection()
    {
        foreach (var file in _files)
        {
            file.IsSelected = false;
        }
        StateHasChanged();
    }

    // 点击空白区域取消选中
    private void OnFileGridClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // 如果点击的是空白区域（不是文件卡片），取消所有选中
        ClearSelection();

        // 隐藏操作菜单
        _menuVisible = false;
        StateHasChanged();
    }


    // 显示右键菜单（通过 JS 互操作调用）
    [JSInvokable]
    public void ShowContextMenuJS(int fileId, double clientX, double clientY)
    {
        var file = _files.FirstOrDefault(f => f.File.Id == fileId);
        if (file != null)
        {
            _menuFile = file;
            _menuX = (int)clientX;
            _menuY = (int)clientY;
            _menuVisible = true;
            StateHasChanged();
        }
    }

    // 隐藏操作菜单（通过 JS 互操作调用）
    [JSInvokable]
    public void HideContextMenu()
    {
        _menuVisible = false;
        StateHasChanged();
    }

    // 键盘快捷键：全选所有文件（通过 JS 互操作调用）
    [JSInvokable]
    public void SelectAllFiles()
    {
        foreach (var file in _files)
        {
            file.IsSelected = true;
        }
        StateHasChanged();
    }

    // 键盘快捷键：删除选中的文件（通过 JS 互操作调用）
    [JSInvokable]
    public async Task DeleteSelectedFiles()
    {
        var selectedFiles = _files.Where(f => f.IsSelected).ToList();
        foreach (var file in selectedFiles)
        {
            await DeleteFile(file);
        }
    }

    // 从操作菜单删除文件（无需确认）
    private async Task DeleteFileFromMenu(SelectableFileItemWeb file)
    {
        _menuVisible = false;
        await DeleteFile(file);
        StateHasChanged();
    }

    // JS 互操作回调：外部文件拖入
    [JSInvokable]
    public async Task OnFilesDropped(FileDropInfo[] files, double offsetX, double offsetY)
    {
        if (files == null || files.Length == 0)
            return;

        for (int i = 0; i < files.Length; i++)
        {
            try
            {
                // 通过 JS 读取文件内容
                var fileData = await JSRuntime.InvokeAsync<FileDataInfo>("DragDropInterop.readDroppedFile", i);
                if (fileData != null)
                {
                    // 将 base64 转换为字节数组
                    var bytes = Convert.FromBase64String(fileData.Data);
                    using var stream = new MemoryStream(bytes);

                    // 检查是否存在同名文件
                    bool overwrite = await FileClient.FileExistsAsync(fileData.Name);

                    // 上传文件
                    await FileClient.UploadFileAsync(fileData.Name, stream, fileData.Type, overwrite);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"上传文件失败: {ex.Message}");
            }
        }

        // 清理暂存的文件
        await JSRuntime.InvokeVoidAsync("DragDropInterop.clearDroppedFiles");
    }

    // JS 互操作用的数据类
    public class FileDropInfo
    {
        public string Name { get; set; } = string.Empty;
        public long Size { get; set; }
        public string Type { get; set; } = string.Empty;
    }

    public class FileDataInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public long Size { get; set; }
        public string Data { get; set; } = string.Empty;
    }

    private void BatchDownload()
    {
        foreach (var file in _files.Where(f => f.IsSelected))
        {
            DownloadFile(file);
        }
    }

    private async Task BatchDelete()
    {
        var filesToDelete = _files.Where(f => f.IsSelected).ToList();
        foreach (var file in filesToDelete)
        {
            await DeleteFile(file);
        }
        ClearSelection();
    }

    private async Task Logout()
    {
        await TextHubClient.DisconnectAsync();
        await AuthManager.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        TextHubClient.ConnectionStateChanged -= OnConnectionStateChanged;
        TextHubClient.TextUpdateReceived -= OnTextUpdateReceived;
        TextHubClient.FileUpdateReceived -= OnFileUpdateReceived;
        _throttleCts?.Cancel();
        _throttleCts?.Dispose();
        _dotNetRef?.Dispose();
        _contextMenuDotNetRef?.Dispose();
    }

    // Web 专用的可选择文件项
    private class SelectableFileItemWeb
    {
        public FileItemDto File { get; }
        public bool IsSelected { get; set; }

        // UI 辅助属性
        public string FileIcon => GetFileIcon(File.MimeType);
        public string FileSizeText => FormatFileSize(File.FileSize);
        public string FileType => GetFileType(File.MimeType);
        public string UploadedAtText => File.UploadedAt.ToLocalTime().ToString("MM-dd HH:mm");

        public SelectableFileItemWeb(FileItemDto file)
        {
            File = file;
        }

        private string GetFileIcon(string? mimeType)
        {
            if (string.IsNullOrEmpty(mimeType))
                return "📎";

            return mimeType switch
            {
                _ when mimeType.StartsWith("image/") => "📷",
                _ when mimeType.StartsWith("video/") => "🎬",
                _ when mimeType.StartsWith("audio/") => "🎵",
                "application/pdf" => "📄",
                "application/msword" => "📄",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "📄",
                "text/plain" => "📄",
                "application/zip" => "📦",
                "application/x-rar-compressed" => "📦",
                "application/x-7z-compressed" => "📦",
                "application/x-tar" => "📦",
                "text/html" => "💻",
                "text/css" => "💻",
                "application/javascript" => "💻",
                "text/javascript" => "💻",
                "application/json" => "💻",
                "application/xml" => "💻",
                _ when mimeType.Contains("csharp") => "💻",
                _ when mimeType.Contains("python") => "💻",
                _ when mimeType.Contains("java") => "💻",
                _ => "📎"
            };
        }

        private string GetFileType(string? mimeType)
        {
            if (string.IsNullOrEmpty(mimeType))
                return "未知";

            return mimeType switch
            {
                _ when mimeType.StartsWith("image/") => "图片",
                _ when mimeType.StartsWith("video/") => "视频",
                _ when mimeType.StartsWith("audio/") => "音频",
                "application/pdf" => "PDF",
                "application/msword" => "Word",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "Word",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "Excel",
                "application/vnd.openxmlformats-officedocument.presentationml.presentation" => "PPT",
                "text/plain" => "文本",
                "application/zip" => "压缩包",
                "application/x-rar-compressed" => "压缩包",
                "application/x-7z-compressed" => "压缩包",
                "application/x-tar" => "压缩包",
                _ when mimeType.StartsWith("text/") => "代码",
                _ when mimeType.Contains("json") => "JSON",
                _ when mimeType.Contains("xml") => "XML",
                _ => "文件"
            };
        }

        private string FormatFileSize(long bytes)
        {
            string[] sizes = { "B", "KB", "MB", "GB" };
            double len = bytes;
            int order = 0;
            while (len >= 1024 && order < sizes.Length - 1)
            {
                order++;
                len = len / 1024;
            }
            return $"{len:0.#} {sizes[order]}";
        }
    }

@page "/pad"
@using SyncPad.Client.Core.Services
@using SyncPad.Shared.Models
@inject IAuthManager AuthManager
@inject IApiClient ApiClient
@inject ITextHubClient TextHubClient
@inject IFileClient FileClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>面板 - SyncPad</PageTitle>

<div class="pad-layout">
    <!-- 左侧主区域（文本编辑） -->
    <div class="text-area">
        <!-- 顶部工具栏 -->
        <div class="toolbar">
            <div class="user-info">
                <span>用户: <strong>@AuthManager.Username</strong></span>
            </div>
            <div class="toolbar-actions">
                <button class="btn-secondary" @onclick="RefreshText">刷新</button>
                <button class="btn-danger" @onclick="Logout">登出</button>
            </div>
        </div>

        <!-- 移动端文本编辑工具栏 -->
        <div class="mobile-edit-toolbar">
            <button class="btn-mobile" @onclick="SelectAllText">全选</button>
            <button class="btn-mobile" @onclick="CopyText">复制</button>
            <button class="btn-mobile btn-delete" @onclick="ClearText">清空</button>
        </div>

        <!-- 文本编辑区域 -->
        <div class="editor-container">
            <textarea @ref="_textareaRef"
                      id="syncpad-textarea"
                      name="syncpad_content_field"
                      @bind="_content"
                      @bind:event="oninput"
                      @bind:after="HandleTextInput"
                      @onpaste="HandleTextPaste"
                      autocomplete="off"
                      autocorrect="off"
                      autocapitalize="off"
                      spellcheck="false"
                      inputmode="text"
                      placeholder="在这里输入文本..."></textarea>
        </div>

        <!-- 状态栏 -->
        <div class="status-bar">
            <div class="connection-status">
                <span class="status-indicator @(_isConnected ? "connected" : "disconnected")"></span>
                <span>@_connectionStatus</span>
            </div>
        </div>
    </div>

    <!-- 右侧文件区域 -->
    <div class="file-area">
        <!-- 文件区域标题栏 -->
        <div class="file-header">
            <h3>文件列表</h3>
            <label class="btn-primary upload-btn">
                上传
                <InputFile OnChange="HandleFileSelected" style="display: none;" />
            </label>
        </div>

        <!-- 文件列表（Grid 布局） -->
        <div class="file-grid"
             @ref="_fileGridRef"
             @onclick="OnFileGridClick">
            @if (_files.Count == 0)
            {
                <div class="empty-state">暂无文件</div>
            }
            else
            {
                @foreach (var file in _files)
                {
                    <div class="file-card @(file.IsSelected ? "selected" : "")"
                         data-file-id="@file.File.Id"
                         @onclick="(e) => HandleFileClick(e, file)"
                         @onclick:stopPropagation="true">
                        <div class="file-icon-container">
                            <div class="file-icon">@file.FileIcon</div>
                        </div>
                        <div class="file-info">
                            <div class="file-name" title="@file.File.FileName">@file.File.FileName</div>
                            <div class="file-meta">@file.FileSizeText · @file.FileType · @file.UploadedAtText</div>
                        </div>
                    </div>
                }
            }

            <!-- 操作菜单 -->
            @if (_menuVisible && _menuFile != null)
            {
                <div class="context-menu" style="left: @(_menuX)px; top: @(_menuY)px;" @onclick:stopPropagation="true">
                    <div class="context-menu-item" @onclick="() => DownloadFile(_menuFile)">下载</div>
                    <div class="context-menu-separator"></div>
                    <div class="context-menu-item context-menu-danger" @onclick="() => DeleteFileFromMenu(_menuFile)">删除</div>
                </div>
            }
        </div>

        <!-- 批量操作工具栏 -->
        @if (SelectedFilesCount > 0)
        {
            <div class="batch-toolbar">
                <span class="batch-info">已选择 @SelectedFilesCount 个文件</span>
                <button class="btn-success btn-sm" @onclick="BatchDownload">批量下载</button>
                <button class="btn-danger btn-sm" @onclick="BatchDelete">批量删除</button>
                <button class="btn-secondary btn-sm" @onclick="ClearSelection">取消</button>
            </div>
        }
    </div>
</div>

